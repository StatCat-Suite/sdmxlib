{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Root",
  "$defs": {
    "Root": {
      "title": "Root",
      "description": "``inventory/<seq>.json`` carrying the history fields (Inventory 1.2, spec §6.2).\n\nThe fields of ``root.schema.json``, with ``previous_root_sha256`` and\n``changes`` required and the ``reinstate`` kind.\n\nAttributes:\n    previous_root_sha256: The SHA-256 of the stored bytes of root\n        ``seq - 1``, or None for version 1.\n    changes: One item per product whose leaf or tombstones differ from root\n        ``seq - 1``'s, sorted by ``product_id``.",
      "type": "object",
      "properties": {
        "format_version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+$"
        },
        "seq": {
          "type": "integer"
        },
        "previous_inventory": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "restore_epoch": {
          "type": "integer"
        },
        "created_at": {
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/Producer"
        },
        "embargo": {
          "type": "boolean"
        },
        "products": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/LeafRef"
          }
        },
        "retired": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Tombstone"
          }
        },
        "event": {
          "$ref": "#/$defs/Event"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "description": "A JSON value of any kind."
            }
          },
          "default": {}
        },
        "previous_root_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChangeItem"
          }
        }
      },
      "required": [
        "format_version",
        "seq",
        "previous_inventory",
        "restore_epoch",
        "created_at",
        "producer",
        "embargo",
        "products",
        "retired",
        "event",
        "previous_root_sha256",
        "changes"
      ]
    },
    "Producer": {
      "title": "Producer",
      "description": "What sealed the edition: a name and its version, e.g. a product builder.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "LeafRef": {
      "title": "LeafRef",
      "description": "A root's pointer to one product's leaf.\n\nAttributes:\n    leaf: The leaf's path, ``inventory/leaves/<leaf_sha256>.json``.\n    leaf_sha256: The SHA-256 of the leaf's bytes.",
      "type": "object",
      "properties": {
        "leaf": {
          "type": "string"
        },
        "leaf_sha256": {
          "type": "string"
        }
      },
      "required": [
        "leaf",
        "leaf_sha256"
      ]
    },
    "Tombstone": {
      "title": "Tombstone",
      "description": "A retired edition, kept so it stays distinct from one never recorded.\n\nAttributes:\n    product_id: Its product.\n    edition_id: The edition.\n    retired_at: When it was retired.",
      "type": "object",
      "properties": {
        "product_id": {
          "type": "string"
        },
        "edition_id": {
          "type": "string"
        },
        "retired_at": {
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "edition_id",
        "retired_at"
      ]
    },
    "Event": {
      "title": "Event",
      "description": "Who wrote an Inventory version, and why.\n\nAttributes:\n    actor: The acting principal, from the writer's identity, never from a caller.\n    reason: Why, in the actor's words.\n    kind: What the version records. A writer records an `EventKind`; a\n        root read back may carry a kind added in a later 1.x format, which\n        an audit or alerting consumer treats as other.",
      "type": "object",
      "properties": {
        "actor": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "correct",
            "describe",
            "embargo-change",
            "reinstate",
            "release",
            "restore",
            "retire",
            "rollback",
            "seal",
            "withdraw"
          ],
          "type": "string"
        }
      },
      "required": [
        "actor",
        "reason",
        "kind"
      ]
    },
    "ChangeItem": {
      "title": "ChangeItem",
      "description": "One product whose leaf or tombstones differ from the base version's (spec §6.3).\n\nAttributes:\n    product_id: The product.\n    leaf_sha256: Its leaf hash in the base version and in this version.\n    entries: One item per edition whose entry or tombstone differs, sorted\n        by ``edition_id``.",
      "type": "object",
      "properties": {
        "product_id": {
          "type": "string"
        },
        "leaf_sha256": {
          "$ref": "#/$defs/LeafHashes"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EntryItem"
          }
        }
      },
      "required": [
        "product_id",
        "leaf_sha256",
        "entries"
      ]
    },
    "LeafHashes": {
      "title": "LeafHashes",
      "description": "A product's leaf hash before and after a version.\n\nAttributes:\n    from: In the base version, or None for a product new to the Inventory.\n    to: In this version, or None for a product removed from it.",
      "type": "object",
      "properties": {
        "from": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "EntryItem": {
      "title": "EntryItem",
      "description": "One edition whose entry or tombstone a version changed (spec §6.3).\n\nAttributes:\n    edition_id: The edition.\n    from: Its state in the base version, ``tombstone`` when the base\n        version's ``retired`` holds it, or None when it has neither.\n    to: The same for this version; None drops its tombstone.\n    entry: The new entry's seven fields, present exactly when ``to`` is a\n        state.",
      "type": "object",
      "properties": {
        "edition_id": {
          "type": "string"
        },
        "from": {
          "enum": [
            "embargoed",
            "live",
            "superseded",
            "withdrawn",
            "tombstone",
            null
          ]
        },
        "to": {
          "enum": [
            "embargoed",
            "live",
            "superseded",
            "withdrawn",
            "tombstone",
            null
          ]
        },
        "entry": {
          "$ref": "#/$defs/EntryRecord"
        }
      },
      "required": [
        "edition_id",
        "from",
        "to"
      ],
      "not": {
        "properties": {
          "from": {
            "const": null
          },
          "to": {
            "const": null
          }
        }
      },
      "if": {
        "properties": {
          "to": {
            "enum": [
              "embargoed",
              "live",
              "superseded",
              "withdrawn"
            ]
          }
        }
      },
      "then": {
        "required": [
          "entry"
        ]
      },
      "else": {
        "not": {
          "required": [
            "entry"
          ]
        }
      }
    },
    "EntryRecord": {
      "title": "EntryRecord",
      "description": "A change item's copy of a ``LeafEntry``: seven fields, without\n``structure_source``, ``artefacts`` or a later optional field.",
      "type": "object",
      "properties": {
        "edition_id": {
          "type": "string"
        },
        "previous": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "embargoed",
            "live",
            "superseded",
            "withdrawn"
          ]
        },
        "manifest_sha256": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "state_changed_at": {
          "type": "string"
        },
        "release_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "edition_id",
        "previous",
        "state",
        "manifest_sha256",
        "schema_version",
        "state_changed_at",
        "release_at"
      ]
    }
  }
}
