# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# macOS Finder metadata
.DS_Store

# Virtual environments
.venv

# uv lockfile — sdmxlib is a published library; downstream consumers
# resolve against pyproject.toml. Committing the lockfile would leak
# whichever index the local environment used (e.g. a private package mirror).
uv.lock

# Local env / secrets
.env
.envrc

# MkDocs generated site
site/
public/

# Coverage reports
.coverage
coverage.xml
htmlcov/

# Benchmark baselines — local snapshots, not part of the repo
bench/baselines/
.benchmarks/

# Claude Code: shared project settings are tracked (.claude/settings.json —
# it carries the suppression-policy hook); per-developer permission grants
# are not.
.claude/settings.local.json
mutants/
.mutmut-cache
.hypothesis/

# Registry sweep: raw registry documents and full per-artefact reports.
# Gigabytes, and specific to the day they were fetched. The trimmed
# summaries under bench/sweep/summaries/ are what is committed.
bench/sweep/out/
# Competitor benchmark corpus: BIS documents, fetched on first run; the
# repository does not redistribute them. See bench/compete/README.md.
bench/compete/cache/
